# Omni API connection — copy this file to `omni.env` and fill in.
# `omni.env` is gitignored; never commit real values.

# Your Omni instance URL — the host in your dashboard URLs, without /api.
# e.g. in https://acme.omniapp.co/dashboards/ab12cd34 it's https://acme.omniapp.co
OMNI_BASE_URL=https://acme.omniapp.co

# API key, sent as `Authorization: Bearer <key>`.
#   Organization API key (recommended): Settings -> API access -> Organization keys.
#     Needed for the dashboard EXPORT endpoint (/unstable/documents/{id}/export) and
#     sees every dashboard. Has Org Admin rights — treat it as a secret, rotate after.
#   Personal Access Token: Profile -> Manage account -> Generate token.
#     Works for listing, queries, model YAML, SQL and downloads, but NOT for export,
#     and sees only what that user can see.
OMNI_API_KEY=paste-your-key-here
