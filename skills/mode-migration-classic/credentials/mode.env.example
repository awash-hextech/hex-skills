# Mode API connection — copy this file to `mode.env` and fill in.
# `mode.env` is gitignored; never commit real values.

# Your Mode workspace (a.k.a. account) slug — the segment after app.mode.com/ in
# your report URLs. e.g. in https://app.mode.com/acme/reports/ab12cd34 it's "acme".
MODE_WORKSPACE=acme

# API token + secret. Create them in Mode:
#   Workspace/User Settings -> API Tokens -> Create new token
# Mode shows the token (an ID) and a secret (shown only once). The two are used as
# HTTP Basic auth (token = username, secret = password).
MODE_TOKEN=your-api-token-id
MODE_SECRET=paste-the-long-secret-here

# Optional: override the API host (default https://app.mode.com). Set this only if
# your org is on a dedicated / regional Mode instance.
# MODE_HOST=https://app.mode.com
